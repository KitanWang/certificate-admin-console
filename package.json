{
  "name": "certificate-admin-console",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant certificate administration console with bulk issuance, revocation and CSV export",
  "scripts": {
    "start": "node scripts/start.js",
    "build:web": "vite build --config vite.config.mjs",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/reset.js",
    "gen:100k": "node scripts/generate-100k.js",
    "verify": "node scripts/verify.js",
    "verify:export": "node scripts/verify.js --with-export"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
